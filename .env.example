# Public base URL of this service (must match the redirect URIs you register).
# Cookies are marked Secure automatically when this is https://.
BASE_URL=http://localhost:8080

# Comma-separated emails that get admin access on login.
ADMIN_EMAILS=you@example.com

# Google  — redirect URI: ${BASE_URL}/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft (Entra ID, "common" tenant) — redirect URI: ${BASE_URL}/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# GitHub OAuth App — callback URL: ${BASE_URL}/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional overrides
# DB_PATH=/data/shim.db
# LISTEN_ADDR=0.0.0.0:8080
# RUST_LOG=info

# --- Reverse proxy / ForwardAuth ---
# Share the session cookie across subdomains (jenkins.example.com, gerrit.example.com...).
# Required for ForwardAuth across services.
# COOKIE_DOMAIN=example.com
# /auth/verify requires is_admin by default; set false to allow any logged-in user.
# VERIFY_REQUIRE_ADMIN=true
